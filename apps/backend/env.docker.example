# Sao chép thành apps/backend/.env.docker (gitignored) — file này do docker-compose.deploy.yml nạp.
#   npm run bootstrap   hoặc: copy env.docker.example .env.docker
#
# Trong container: DATABASE_URL / REDIS được compose ghi đè; vẫn cần SESSION_SECRET, FRONTEND_ORIGINS, …
# Mẫu dài (production): env.docker.production.example | otp90: env.otp90-production.example

# --- Bắt buộc cho deploy ---
SESSION_SECRET=change-me-long-random

# CORS — domain admin + site production (CSV)
FRONTEND_ORIGINS=http://localhost:6001,http://127.0.0.1:6001

# Dòng dưới compose sẽ ghi đè khi chạy stack Docker — giữ làm tham chiếu / chạy tool trên host
DATABASE_URL=postgresql://automation_admin:automation_admin_dev@postgres:5432/automation_store
REDIS_URL=redis://redis:6379

PORT=6000
SEPAY_PORT=5000
SEPAY_HOST=0.0.0.0

# SEPAY_WEBHOOK_SECRET=
# SEPAY_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RENEW_ADOBE_API_BASE_URL=http://renew-adobe-api:xxxx
