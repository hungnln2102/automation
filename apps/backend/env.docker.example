# Sao chép thành apps/backend/.env.docker (gitignored) — file này do docker-compose.deploy.yml nạp.
#   npm run bootstrap   hoặc: copy env.docker.example .env.docker
#
# DATABASE_URL: backend + scheduler đọc trực tiếp từ file này (compose không ghi đè).
# Postgres trong Docker: dùng host `postgres`, cổng 5432. Postgres ngoài VPS: xem env.docker.external-db.example
# REDIS_URL trong container do compose set → redis:6379 (dòng REDIS dưới chỉ tham chiếu khi chạy tool trên host).
# Mẫu dài (production): env.docker.production.example | otp90: env.otp90-production.example

# --- Bắt buộc cho deploy ---
SESSION_SECRET=change-me-long-random

# CORS — domain admin + site production (CSV)
FRONTEND_ORIGINS=http://localhost:6001,http://127.0.0.1:6001

DATABASE_URL=postgresql://admin_store_admin:admin_store_dev@postgres:5432/admin_store
REDIS_URL=redis://redis:6379

PORT=6000
SEPAY_PORT=5000
SEPAY_HOST=0.0.0.0

# SEPAY_WEBHOOK_SECRET=
# SEPAY_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RENEW_ADOBE_API_BASE_URL=http://renew-adobe-api:xxxx
