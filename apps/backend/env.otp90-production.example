# Mẫu otp90 — merge vào apps/backend/.env.docker (hoặc copy block vào file thật).
# Nginx: deploy/nginx/otp90-automation.conf (api.otp90.com → upstream :6000).
# Frontend production: apps/frontend/.env.production từ .env.production.example (VITE_API_BASE_URL).

NODE_ENV=production
APP_ENV=docker
PORT=6000

FRONTEND_ORIGINS=http://admin.otp90.com,http://otp90.com,http://www.otp90.com,https://admin.otp90.com,https://otp90.com,https://www.otp90.com

PUBLIC_BASE_URL=http://otp90.com

COOKIE_SECURE=auto

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:6432/automation_store

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6480

APP_TIMEZONE=Asia/Ho_Chi_Minh

SESSION_SECRET=

# RENEW_ADOBE_PUBLIC_API_KEY=
