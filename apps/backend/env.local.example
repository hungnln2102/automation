# Sao chép thành backend/.env.local (gitignored) — chỉ dùng khi chạy local.
#   copy env.local.example .env.local
#
# DB trên VPS (khuyến nghị): mở SSH tunnel trước khi npm run dev:
#   npm run tunnel:vps
#   hoặc: ssh -L 5432:127.0.0.1:5432 root@161.248.146.6
#
# DB local Docker: npm run docker:up && npm run db:setup (cùng DATABASE_URL bên dưới).

DATABASE_URL=postgresql://admin_store_admin:admin_store_dev@127.0.0.1:5432/admin_store
DB_SCHEMA_FINANCE=finance
DB_SCHEMA_RENEW_ADOBE=system_automation

PORT=6000
FRONTEND_ORIGINS=http://localhost:6001,http://127.0.0.1:6001

REDIS_ENABLED=false
SESSION_SECRET=dev-local-change-me

DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin1

# Adobe Check — false = hiện browser khi test local; production/VPS nên true
# PLAYWRIGHT_HEADLESS=false
