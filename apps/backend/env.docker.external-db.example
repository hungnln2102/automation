# ============================================================================
# Postgres ngoài VPS (IP/host tĩnh) — copy block vào apps/backend/.env.docker
# hoặc merge với env.docker.production.example.
#
# Backend chỉ đọc DATABASE_URL (Knex + pg). Các biến DB_HOST / DB_USER / ... không
# được code backend dùng — có thể để làm ghi chú tay.
#
# Trong container Docker: host phải là địa chỉ mà container REACH ĐƯỢC (IP public,
# private LAN, hoặc host.docker.internal tùy hạ tầng). Firewall Postgres phải
# cho phép IP VPS.
#
# Ký tự đặc biệt trong mật khẩu phải mã hóa URL, ví dụ: ! → %21, @ → %40
# ============================================================================

# Ví dụ (thay bằng giá trị thật; không commit file .env.docker):
# DATABASE_URL=postgresql://admin:ENCODED_PASSWORD@203.0.113.10:5432/mydtbmav

DATABASE_URL=postgresql://USER:PASSWORD_ENCODED@HOST_OR_IP:5432/DATABASE_NAME

# Ghi chú tùy chọn (không ảnh hưởng runtime):
# DB_HOST=203.0.113.10
# DB_PORT=5432
# DB_USER=admin
# DB_PASS=plain-only-for-your-notes
# DB_NAME=mydtbmav
