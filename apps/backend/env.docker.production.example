# ============================================================================
# Mẫu env production đầy đủ — copy thành apps/backend/.env.docker (gitignored)
# rồi chỉnh domain, SESSION_SECRET, DATABASE_URL host (nếu chạy Node trên host).
#
# Docker (./deploy.sh): DATABASE_URL lấy từ file này (không ghi đè trong compose).
# REDIS_URL trong container do compose set → redis:6379. Các giá trị khác vẫn từ file này.
# ============================================================================

NODE_ENV=production
APP_ENV=docker
APP_NAME=automation
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ----- API -----
# Docker deploy: PORT=6000 trong docker-compose.deploy.yml.
PORT=6000
PUBLIC_BASE_URL=https://otp90.com

FRONTEND_ORIGINS=http://admin.otp90.com,http://otp90.com,http://www.otp90.com,https://admin.otp90.com,https://otp90.com,https://www.otp90.com

COOKIE_SECURE=auto

SESSION_SECRET=PASTE_STRONG_HEX_HERE
SESSION_NAME=automation.sid

DISABLE_CSRF=false

# ---------- PostgreSQL ----------
# Backend trong Docker + Postgres cùng stack: DATABASE_URL dùng host `postgres`, cổng 5432.
# Chạy psql trên HOST VPS vào container Postgres publish: 127.0.0.1:5432 — xem docker-compose.yml.
# Postgres máy khác / IP tĩnh: env.docker.external-db.example (mật khẩu URL-encode nếu có ký tự đặc biệt).
DATABASE_URL=postgresql://admin_store_admin:REPLACE_PASSWORD@postgres:5432/admin_store
DB_SCHEMA_FINANCE=finance
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=REPLACE_STRONG_ADMIN_PASSWORD

DB_SCHEMA_RENEW_ADOBE=system_automation

DB_KNEX_POOL_MAX=10
DB_RAW_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=15000

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6480/0

# ---------- Scheduler ----------
CRON_SCHEDULE=1 0 * * *
RUN_CRON_ON_START=false
CRON_INVOKE_SECRET=PASTE_RANDOM_CRON_SECRET

PLAYWRIGHT_HEADLESS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_ORDER_NOTIFICATION=false
SEND_ERROR_NOTIFICATION=false

SEPAY_HOST=0.0.0.0
SEPAY_PORT=5000

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
