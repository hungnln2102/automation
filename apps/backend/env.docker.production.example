# ============================================================================
# Mẫu env production đầy đủ — copy thành apps/backend/.env.docker (gitignored)
# rồi chỉnh domain, SESSION_SECRET, DATABASE_URL host (nếu chạy Node trên host).
#
# Docker (./deploy.sh): DATABASE_URL và REDIS_URL trong compose ghi đè trong container —
# các giá trị dưới vẫn cần cho FRONTEND_ORIGINS, SESSION_SECRET, CRON_*, v.v.
# ============================================================================

NODE_ENV=production
APP_ENV=docker
APP_NAME=automation
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ----- API -----
# Docker deploy: PORT=6000 trong docker-compose.deploy.yml.
PORT=6000
PUBLIC_BASE_URL=https://otp90.com

FRONTEND_ORIGINS=http://admin.otp90.com,http://otp90.com,http://www.otp90.com,https://admin.otp90.com,https://otp90.com,https://www.otp90.com

COOKIE_SECURE=auto

SESSION_SECRET=PASTE_STRONG_HEX_HERE
SESSION_NAME=automation.sid

DISABLE_CSRF=false

# ---------- PostgreSQL ----------
# Backend trong Docker: compose ghi đè → postgres:5432.
# Chạy Node/pg_dump trên HOST VPS: 127.0.0.1:6432 — xem docker-compose.yml.
DATABASE_URL=postgresql://automation_admin:REPLACE_PASSWORD@127.0.0.1:6432/automation_store
DB_SCHEMA_FINANCE=finance
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=REPLACE_STRONG_ADMIN_PASSWORD

DB_SCHEMA_RENEW_ADOBE=system_automation

DB_KNEX_POOL_MAX=10
DB_RAW_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=15000

# ---------- Redis ----------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6480/0

# ---------- Scheduler ----------
CRON_SCHEDULE=1 0 * * *
RUN_CRON_ON_START=false
CRON_INVOKE_SECRET=PASTE_RANDOM_CRON_SECRET

PLAYWRIGHT_HEADLESS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_ORDER_NOTIFICATION=false
SEND_ERROR_NOTIFICATION=false

SEPAY_HOST=0.0.0.0
SEPAY_PORT=5000

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
