# ---------------------------------------------------------------------------
# Renew Adobe — dịch vụ tách (tùy chọn)
# Sao chép/cộng các dòng này vào backend/.env
# Tài liệu: ../docs/renew-adobe-service.md
# ---------------------------------------------------------------------------

# Khóa dùng chung: Orderlist (khi bật proxy) + process `renew-adobe-api` BẮT trùng nhau.
# Tạo mới:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENEW_ADOBE_INTERNAL_KEY=

# Có giá trị (vd. http://127.0.0.1:4002) → API chính proxy /api/renew-adobe/* sang process riêng.
# Để trống hoặc comment → Renew Adobe chạy in-process (mặc định trước khi tách).
# RENEW_ADOBE_API_BASE_URL=http://127.0.0.1:4002

# Cổng lắng nghe khi chạy: npm run start:renew-adobe-api (mặc định 4002, tránh trùng 4001).
RENEW_ADOBE_API_PORT=4002

# (Tùy chọn, prod khuyên dùng) Cùng giá trị với store proxy — bảo vệ POST /api/renew-adobe/public/activate.
# Khi bật: yêu cầu X-Renew-Public-Key: <giá trị> (BFF gắn, không cần gửi từ browser trần nếu proxy store set header).
# RENEW_ADOBE_PUBLIC_API_KEY=

# DongVan OAuth2 mail OTP — https://docs.dongvanfb.net/utils/get-messages-mail-with-oauth2
# OTP_DONGVAN_BASE_URL=https://tools.dongvanfb.net
# OTP_DONGVAN_ENDPOINT=/api/get_messages_oauth2
# OTP_DONGVAN_DEFAULT_CLIENT_ID=
# OTP_DONGVAN_CODE_ENDPOINT=/api/get_code_oauth2
# OTP_DONGVAN_CODE_TYPE=adobe
# Panel public OTP: chỉ lấy mail Adobe "Verification code" trong N ms (mặc định 30 phút)
# OTP_PUBLIC_MAX_AGE_MS=1800000

# Gọi GET /api/run-due-notification từ cron: ?secret=... hoặc X-Cron-Invoke-Secret / Bearer. Bắt buộc.
# CRON_INVOKE_SECRET=

# Đặt =1|true|yes → mỗi lần check (cron hoặc POST /accounts/:id/check): nếu cột/scrape id_product
# không còn token chứa "CCP" nhưng team vẫn còn user, tự xóa toàn bộ user (coi là hết gói CCP).
# Để 0 hoặc comment để tắt (mặc định tắt).
# RENEW_ADOBE_DELETE_ALL_WHEN_NO_CCP=0
