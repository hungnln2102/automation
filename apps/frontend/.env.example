# Sao chép thành `.env` hoặc `.env.local` trong apps/frontend (gitignored).
# Dev: Vite proxy /api → VITE_API_PROXY_TARGET (mặc định :6000). Scripts dev:frontend set sẵn.

# VITE_API_PROXY_TARGET=http://127.0.0.1:6000

# Build production: dùng `.env.production` (mẫu `.env.production.example`).
# Để VITE_API_BASE_URL trống nếu Nginx proxy /api cùng host.
