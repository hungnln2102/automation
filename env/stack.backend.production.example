# ============================================================================
# Mẫu env production CHUẨN cho Automation (stack backend — file nạp qua
# BACKEND_ENV_FILE hoặc docker-compose env_file: ./env/stack.backend.env).
#
# Cách dùng:
#   cp env/stack.backend.production.example env/stack.backend.env
#   chỉnh domain, DATABASE_URL thật, SESSION_SECRET...
#
# Docker (./deploy.sh): DATABASE_URL và REDIS_URL trong compose ghi đè — giá trị dưới đây
# chỉ áp ra ngoài khi chạy Node trực tiếp trên host.
# ============================================================================

NODE_ENV=production
APP_ENV=production
APP_NAME=automation
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ----- API -----
# Docker deploy: cố định 6000 trong docker-compose.deploy.yml (map HOST:6000→container).
# Chạy trực tiếp trên host: giữ PORT khớp Nginx/upstream.
PORT=6000
# Canonical site (vd. otp90.com) hoặc admin — tuỳ nơi bạn đặt link trong email/metadata.
PUBLIC_BASE_URL=https://otp90.com

# HTTPS + đủ bản HTTP nếu còn thử chỉ có http://… (không có SSL) — không khớp giao thức → "Blocked by CORS".
FRONTEND_ORIGINS=http://admin.otp90.com,http://otp90.com,http://www.otp90.com,https://admin.otp90.com,https://otp90.com,https://www.otp90.com

# HTTPS-only production: chỉnh về chỉ các https:// và COOKIE_SECURE=true.
# Prod sau Certbot có thể: FRONTEND_ORIGINS=https://admin.otp90.com,... ; COOKIE_SECURE=true
COOKIE_SECURE=auto

# Bắt buộc (appConfig thoát tiến trình nếu default): random 48+ bytes hex
SESSION_SECRET=PASTE_STRONG_HEX_HERE
SESSION_NAME=automation.sid

# Không bật trừ khi debug có chủ đích — production nên để FALSE hoặc bỏ dòng (= CSRF bật)
DISABLE_CSRF=false

# ---------- PostgreSQL ----------
# Backend trong Docker: compose ghi đè → postgres:5432 (tên service).
# Chạy Node/pg_dump trên HOST VPS (hoặc Beekeeper tunnel): 127.0.0.1:6432 (map trong docker-compose.yml).
DATABASE_URL=postgresql://automation_admin:REPLACE_PASSWORD@127.0.0.1:6432/automation_store
DB_SCHEMA_FINANCE=finance
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=REPLACE_STRONG_ADMIN_PASSWORD

# Chỉ một dòng đủ — xem apps/backend/src/config/dbSchema/env.js (pickSchema DB_* trước SCHEMA_*).
DB_SCHEMA_RENEW_ADOBE=system_automation

DB_KNEX_POOL_MAX=10
DB_RAW_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=15000

# ---------- Redis (session / queue) — khuyến nghị bật production ----------
# Trên host VPS (ngoài Docker): map 6480 → container 6379 — xem docker-compose.yml.
# Trong container: compose ghi đè → redis://redis:6379
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6480/0

# ---------- Scheduler (scheduler.js) ----------
CRON_SCHEDULE=1 0 * * *
RUN_CRON_ON_START=false
# ENABLE_DB_BACKUP=true
# BACKUP_DATABASE_URL=postgresql://...

# Gọi job HTTP ra ngoài — bắt buộc nếu dùng GET /run-due... với secret
CRON_INVOKE_SECRET=PASTE_RANDOM_CRON_SECRET

# ---------- Renew Adobe ----------
PLAYWRIGHT_HEADLESS=true

# Cron: khi không còn token CCP trong id_product nhưng còn team → xóa hết user (cân nhắc rủi ro)
# RENEW_ADOBE_DELETE_ALL_WHEN_NO_CCP=0

# Bảo POST /public/activate — nếu bật phải gửi X-Renew-Public-Key (và có thể VITE frontend)
# RENEW_ADOBE_PUBLIC_API_KEY=

# Process renew-adobe tách khỏi API chính
# RENEW_ADOBE_API_BASE_URL=http://127.0.0.1:4002
# RENEW_ADOBE_INTERNAL_KEY=

# ---------- Notifications / tuỳ chọn ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEND_ORDER_NOTIFICATION=false
SEND_ERROR_NOTIFICATION=false

SEPAY_HOST=0.0.0.0
SEPAY_PORT=5000

# Dashboard thuế ước tính
# DASHBOARD_MONTHLY_TAX_RATE_PERCENT=0

# ------- Sinh SESSION_SECRET ví dụ:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
