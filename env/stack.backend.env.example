# Copy to `stack.backend.env`, or run `npm run bootstrap` from Automation.
# Production chuẩn (đầy đủ): xem env/stack.backend.production.example → copy chồng vào đây.
#
# Docker deploy (`./deploy.sh` + docker-compose.deploy.yml): DATABASE_URL/REDIS trong container bị ghi đè sang service `postgres` / `redis`; API luôn PORT=6000 trong container — map cổng host bằng BACKEND_HOST_PORT.
# Load order: apps/backend/.env -> this file.
# Automation Docker services: PostgreSQL on host :6432, Redis on host :6480.
#
# Production VPS (otp90): xem env mẫu `stack.backend.otp90-production.example` và Nginx `deploy/nginx/otp90-automation-admin.conf`.

PORT=6000

FRONTEND_ORIGINS=http://localhost:6001,http://127.0.0.1:6001

DATABASE_URL=postgresql://automation_admin:automation_admin_dev@127.0.0.1:6432/automation_store

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6480
