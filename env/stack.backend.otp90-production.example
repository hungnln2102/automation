# Mẫu production — copy thành `stack.backend.env` trên VPS (hoặc merge vào .env systemd).
# Nginx (admin + otp90.com): `deploy/nginx/otp90-automation.conf`

NODE_ENV=production
PORT=6000

# Cả admin + apex (form check trên otp90.com cùng gọi /api hoặc CORS hoá trên subdomain).
FRONTEND_ORIGINS=https://admin.otp90.com,https://otp90.com,https://www.otp90.com

# Trang chủ / form công khai (tuỳ bạn chỉnh HTTPS redirect www → apex trong Nginx)
PUBLIC_BASE_URL=https://otp90.com

# HTTPS: để session/csrf hoạt động đúng.
COOKIE_SECURE=true

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/automation_store

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

APP_TIMEZONE=Asia/Ho_Chi_Minh

# Sinh khóa: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Tuỳ chọn: khóa POST /api/renew-adobe/public/activate — nếu bật, frontend build cần VITE_RENEW_ADOBE_PUBLIC_API_KEY trùng.
# RENEW_ADOBE_PUBLIC_API_KEY=
